 "segments": [
  {
   "start": 6.68,
   "end": 13.42,
   "text": "Yeah, listen here baby, those shiny roads ain't what they seem"
  },
  {
   "start": 20.04,
   "end": 23.92,
   "text": "They build the toll roads, baby, make you pay to roll"
  },
  {
   "start": 23.92,
   "end": 27.36,
   "text": "Old plazas make you stop, then they make you go"
  },
  {
   "start": 27.36,
   "end": 30.96,
   "text": "Cars slam the brakes, the back ends crash and smash"
  },
  {
   "start": 30.96,
   "end": 34.34,
   "text": "NTSB said those booths were the worst on the map"
  },
  {
   "start": 34.34,
   "end": 37.82,
   "text": "Now they got the fast lanes, the rich ones fly on by"
  },
  {
   "start": 37.82,
   "end": 41.38,
   "text": "While the rest of us crawl, watching money flash by"
  },
  {
   "start": 41.38,
   "end": 44.98,
   "text": "Weave in, weave out, the speeds don't match at all"
  },
  {
   "start": 44.98,
   "end": 49.42,
   "text": "One car's racing, the other one's about to fall"
  },
  {
   "start": 51.14,
   "end": 53.5,
   "text": "Toll roads are done, baby"
  },
  {
   "start": 54.56,
   "end": 56.3,
   "text": "Toll road's a dumb"
  },
  {
   "start": 57.36,
   "end": 60.6,
   "text": "Fast lanes make crashes"
  }
 ],
