 "segments": [
  {
   "start": 58.0,
   "end": 63.78,
   "text": "Fast lanes may crash as the wrecks just come"
  },
  {
   "start": 65.0,
   "end": 70.6,
   "text": "Pay to go faster, the rest of us slow"
  },
  {
   "start": 72.12,
   "end": 78.04,
   "text": "Weaving and slamming, the danger grows"
  },
  {
   "start": 79.0,
   "end": 84.48,
   "text": "Tow roads are dumb baby, tow roads are down"
  },
  {
   "start": 85.76,
   "end": 91.52,
   "text": "Fast lanes make crashes, they just keep coming"
  },
  {
   "start": 92.7,
   "end": 96.48,
   "text": "Express lanes look clean, but the mergers get hot"
  },
  {
   "start": 96.48,
   "end": 99.96,
   "text": "Speed up, cut over, somebody gets caught"
  },
  {
   "start": 99.96,
   "end": 101.86,
   "text": "They say the paid side is safer"
  },
  {
   "start": 101.86,
   "end": 105.4,
   "text": "The free side takes the hit, crashes just move over"
  },
  {
   "start": 105.4,
   "end": 107.88,
   "text": "Still the same old mess"
  },
  {
   "start": 107.88,
   "end": 111.04,
   "text": "Lexus lanes, they call them, money buys the clear"
  },
  {
   "start": 111.04,
   "end": 114.24,
   "text": "Poor folks sit in traffic while the rich ones disappear"
  },
  {
   "start": 114.24,
   "end": 117.66,
   "text": "Stop and go plazas used to kill, electronic helps a bit"
  },
  {
   "start": 117.66,
   "end": 121.74,
   "text": "But the split still creates the chaos that won't quit"
  }
 ],
