 "segments": [
  {
   "start": 6.68,
   "end": 13.42,
   "text": "Yeah, listen here baby, those shiny roads ain't what they seem"
  },
  {
   "start": 20.04,
   "end": 23.92,
   "text": "They build the toll roads, baby, make you pay to roll"
  },
  {
   "start": 23.92,
   "end": 27.36,
   "text": "Old plazas make you stop, then they make you go"
  },
  {
   "start": 27.36,
   "end": 30.96,
   "text": "Cars slam the brakes, the back ends crash and smash"
  },
  {
   "start": 30.96,
   "end": 34.34,
   "text": "NTSB said those booths were the worst on the map"
  },
  {
   "start": 34.34,
   "end": 37.82,
   "text": "Now they got the fast lanes, the rich ones fly on by"
  },
  {
   "start": 37.82,
   "end": 41.38,
   "text": "While the rest of us crawl, watching money flash by"
  },
  {
   "start": 41.38,
   "end": 44.98,
   "text": "Weave in, weave out, the speeds don't match at all"
  },
  {
   "start": 44.98,
   "end": 49.42,
   "text": "One car's racing, the other one's about to fall"
  },
  {
   "start": 51.14,
   "end": 53.5,
   "text": "Toll roads are done, baby"
  },
  {
   "start": 54.56,
   "end": 56.3,
   "text": "Toll road's a dumb"
  },
  {
   "start": 57.36,
   "end": 60.6,
   "text": "Fast lanes make crashes"
  },
  {
   "start": 65.0,
   "end": 70.6,
   "text": "Pay to go faster, the rest of us slow"
  },
  {
   "start": 72.12,
   "end": 78.04,
   "text": "Weaving and slamming, the danger grows"
  },
  {
   "start": 79.0,
   "end": 84.48,
   "text": "Tow roads are dumb baby, tow roads are down"
  },
  {
   "start": 85.76,
   "end": 91.52,
   "text": "Fast lanes make crashes, they just keep coming"
  },
  {
   "start": 92.7,
   "end": 96.48,
   "text": "Express lanes look clean, but the mergers get hot"
  },
  {
   "start": 96.48,
   "end": 99.96,
   "text": "Speed up, cut over, somebody gets caught"
  },
  {
   "start": 99.96,
   "end": 101.86,
   "text": "They say the paid side is safer"
  },
  {
   "start": 101.86,
   "end": 105.4,
   "text": "The free side takes the hit, crashes just move over"
  },
  {
   "start": 105.4,
   "end": 107.88,
   "text": "Still the same old mess"
  },
  {
   "start": 107.88,
   "end": 111.04,
   "text": "Lexus lanes, they call them, money buys the clear"
  },
  {
   "start": 111.04,
   "end": 114.24,
   "text": "Poor folks sit in traffic while the rich ones disappear"
  },
  {
   "start": 114.24,
   "end": 117.66,
   "text": "Stop and go plazas used to kill, electronic helps a bit"
  },
  {
   "start": 117.66,
   "end": 121.74,
   "text": "But the split still creates the chaos that won't quit"
  },
  {
   "start": 121.82,
   "end": 125.26,
   "text": "Toll roads are dumb, baby"
  },
  {
   "start": 125.26,
   "end": 128.26,
   "text": "Toll road's are dumb"
  },
  {
   "start": 128.26,
   "end": 132.12,
   "text": "Fast lanes may crash"
  },
  {
   "start": 132.12,
   "end": 135.3,
   "text": "The wrecks just come"
  },
  {
   "start": 135.3,
   "end": 139.28,
   "text": "Pay to go faster"
  },
  {
   "start": 139.28,
   "end": 142.34,
   "text": "The rest of us slow"
  },
  {
   "start": 143.94,
   "end": 146.46,
   "text": "Weaving and slamming"
  },
  {
   "start": 146.46,
   "end": 149.82,
   "text": "The danger grows"
  },
  {
   "start": 150.76,
   "end": 153.22,
   "text": "Tall roads are dumb, baby"
  },
  {
   "start": 153.22,
   "end": 155.3,
   "text": "Tall roads"
  },
  {
   "start": 155.3,
   "end": 156.22,
   "text": "Are dumb"
  },
  {
   "start": 157.42,
   "end": 158.82,
   "text": "Fast lanes"
  },
  {
   "start": 158.82,
   "end": 160.24,
   "text": "Make crashes"
  },
  {
   "start": 160.24,
   "end": 162.54,
   "text": "They just keep"
  },
  {
   "start": 162.54,
   "end": 163.26,
   "text": "Coming"
  },
  {
   "start": 165.04,
   "end": 166.62,
   "text": "They sell you speed"
  },
  {
   "start": 166.62,
   "end": 168.84,
   "text": "For a dollar and a dime"
  },
  {
   "start": 168.84,
   "end": 171.26,
   "text": "But the road gets meaner"
  },
  {
   "start": 171.26,
   "end": 172.6,
   "text": "Every single time"
  },
  {
   "start": 172.6,
   "end": 175.34,
   "text": "One lane's flying, the other one's stuck"
  },
  {
   "start": 175.34,
   "end": 179.0,
   "text": "Somebody's gonna get it when the time ends up"
  },
  {
   "start": 179.0,
   "end": 181.98,
   "text": "Oh, toll roads are"
  },
  {
   "start": 182.58,
   "end": 183.98,
   "text": "Yeah."
  },
  {
   "start": 208.0,
   "end": 221.84,
   "text": "Hey, to go faster, the rest of us slow Weaving and slamming, the danger grows"
  },
  {
   "start": 222.58,
   "end": 228.3,
   "text": "Toe roads are dumb, fast lanes may crash"
  },
  {
   "start": 228.3,
   "end": 232.58,
   "text": "Toe road's are dumb baby"
  },
  {
   "start": 236.42,
   "end": 238.76,
   "text": "Toll roads are done"
  },
  {
   "start": 238.0,
   "end": 238.82,
   "text": "Toe roads are done"
  },
  {
   "start": 242.22,
   "end": 245.08,
   "text": "Yeah, don't pay for the fast lane honey"
  },
  {
   "start": 247.58,
   "end": 249.42,
   "text": "It ain't worth the crash"
  },
  {
   "start": 251.0,
   "end": 253.0,
   "text": "Toe road's are done"
  },
  {
   "start": 258.14,
   "end": 260.52,
   "text": "Toe Road's are Dumb"
  }
