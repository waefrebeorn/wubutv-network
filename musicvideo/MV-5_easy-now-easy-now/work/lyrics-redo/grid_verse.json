{
 "lines": [
  {
   "id": "L01",
   "section": "Verse 1",
   "text": "Bare feet on the boardwalk",
   "start": 22.0,
   "end": 23.64
  },
  {
   "id": "L02",
   "section": "Verse 1",
   "text": "Salt on my skin",
   "start": 23.68,
   "end": 25.26
  },
  {
   "id": "L03",
   "section": "Verse 1",
   "text": "You came in laughing",
   "start": 25.26,
   "end": 26.78
  },
  {
   "id": "L04",
   "section": "Verse 1",
   "text": "Said, come on, let's begin",
   "start": 27.6,
   "end": 29.6
  },
  {
   "id": "L05",
   "section": "Verse 1",
   "text": "Blue shirt, red bicycle",
   "start": 29.6,
   "end": 31.5
  },
  {
   "id": "L06",
   "section": "Verse 1",
   "text": "Rolling past the pier",
   "start": 31.78,
   "end": 33.62
  },
  {
   "id": "L07",
   "section": "Verse 1",
   "text": "I was posted up right here",
   "start": 33.62,
   "end": 36.06
  },
  {
   "id": "L08",
   "section": "Verse 1",
   "text": "Now you're pulling near",
   "start": 36.06,
   "end": 38.36
  },
  {
   "id": "L09",
   "section": "Verse 1",
   "text": "Backpack half-zipped",
   "start": 38.9,
   "end": 39.66
  },
  {
   "id": "L10",
   "section": "Verse 1",
   "text": "Keys in your hand",
   "start": 40.46,
   "end": 42.86
  },
  {
   "id": "L11",
   "section": "Verse 1",
   "text": "You nodded at the waves like",
   "start": 42.86,
   "end": 44.56
  },
  {
   "id": "L12",
   "section": "Verse 1",
   "text": "Yeah, they already understand",
   "start": 44.56,
   "end": 46.82
  },
  {
   "id": "L37",
   "section": "Verse 2",
   "text": "Vendor at the corner",
   "start": 85.16,
   "end": 86.5
  },
  {
   "id": "L38",
   "section": "Verse 2",
   "text": "Calling mango sweet",
   "start": 86.5,
   "end": 87.6
  },
  {
   "id": "L39",
   "section": "Verse 2",
   "text": "Socks in the sand",
   "start": 87.6,
   "end": 89.1
  },
  {
   "id": "L40",
   "section": "Verse 2",
   "text": "And the tide tapping time with our feet",
   "start": 89.1,
   "end": 92.92
  },
  {
   "id": "L41",
   "section": "Verse 2",
   "text": "Your laugh hit the air",
   "start": 93.7,
   "end": 95.28
  },
  {
   "id": "L42",
   "section": "Verse 2",
   "text": "Like a hand drum roll",
   "start": 95.44,
   "end": 96.78
  },
  {
   "id": "L43",
   "section": "Verse 2",
   "text": "I forgot the list, forgot the bills",
   "start": 96.78,
   "end": 98.46
  },
  {
   "id": "L44",
   "section": "Verse 2",
   "text": "Forgot what I was told",
   "start": 98.46,
   "end": 102.14
  },
  {
   "id": "L45",
   "section": "Verse 2",
   "text": "Ice ice ice cup sweating",
   "start": 102.14,
   "end": 104.12
  },
  {
   "id": "L46",
   "section": "Verse 2",
   "text": "On the rail by the steps",
   "start": 104.12,
   "end": 105.18
  },
  {
   "id": "L47",
   "section": "Verse 2",
   "text": "You said, don't think too hard",
   "start": 105.18,
   "end": 106.42
  },
  {
   "id": "L48",
   "section": "Verse 2",
   "text": "So I did it, not yet",
   "start": 106.42,
   "end": 107.46
  },
  {
   "id": "L49",
   "section": "Verse 2",
   "text": "Kids with a boombox",
   "start": 107.46,
   "end": 108.8
  },
  {
   "id": "L50",
   "section": "Verse 2",
   "text": "Cutting through the crowd",
   "start": 108.8,
   "end": 109.74
  },
  {
   "id": "L51",
   "section": "Verse 2",
   "text": "You took my sleeve and spun me once",
   "start": 109.74,
   "end": 110.86
  },
  {
   "id": "L52",
   "section": "Verse 2",
   "text": "Like none of it was last",
   "start": 110.86,
   "end": 111.9
  },
  {
   "id": "L74",
   "section": "Bridge",
   "text": "If the rain comes down",
   "start": 148.86,
   "end": 150.1
  },
  {
   "id": "L75",
   "section": "Bridge",
   "text": "We stay out in it",
   "start": 150.18,
   "end": 151.3
  },
  {
   "id": "L76",
   "section": "Bridge",
   "text": "If the day runs long",
   "start": 151.3,
   "end": 152.38
  },
  {
   "id": "L77",
   "section": "Bridge",
   "text": "We still move with it",
   "start": 152.46,
   "end": 153.56
  },
  {
   "id": "L78",
   "section": "Bridge",
   "text": "Hand in my hand",
   "start": 153.58,
   "end": 154.58
  },
  {
   "id": "L79",
   "section": "Bridge",
   "text": "No speech, no show",
   "start": 154.68,
   "end": 155.68
  },
  {
   "id": "L80",
   "section": "Bridge",
   "text": "Heart in the breeze",
   "start": 155.68,
   "end": 156.84
  },
  {
   "id": "L81",
   "section": "Bridge",
   "text": "And the bass moves slow",
   "start": 157.02,
   "end": 157.94
  },
  {
   "id": "L82",
   "section": "Bridge",
   "text": "If the sky turns gray",
   "start": 157.94,
   "end": 159.1
  },
  {
   "id": "L83",
   "section": "Bridge",
   "text": "We don't fold in",
   "start": 159.22,
   "end": 160.26
  },
  {
   "id": "L84",
   "section": "Bridge",
   "text": "We lean right back",
   "start": 160.26,
   "end": 161.36
  },
  {
   "id": "L85",
   "section": "Bridge",
   "text": "Let the whole thing spin",
   "start": 161.46,
   "end": 162.46
  },
  {
   "id": "L86",
   "section": "Bridge",
   "text": "You and me, same pace",
   "start": 162.46,
   "end": 163.54
  },
  {
   "id": "L87",
   "section": "Bridge",
   "text": "Same worn-in shoes",
   "start": 163.66,
   "end": 164.88
  },
  {
   "id": "L88",
   "section": "Bridge",
   "text": "Nothing to prove",
   "start": 164.88,
   "end": 166.04
  },
  {
   "id": "L89",
   "section": "Bridge",
   "text": "Nothing to lose",
   "start": 166.2,
   "end": 167.44
  },
  {
   "id": "L90",
   "section": "Bridge",
   "text": "No, no, no",
   "start": 167.5,
   "end": 169.16
  }
 ],
