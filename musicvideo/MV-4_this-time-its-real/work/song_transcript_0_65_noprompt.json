{
 "segments": [
  {
   "start": 0.0,
   "end": 4.0,
   "text": " They said it was over back in all three"
  },
  {
   "start": 4.0,
   "end": 7.7,
   "text": " Then they said it again in 2013"
  },
  {
   "start": 7.7,
   "end": 11.7,
   "text": " Who knew it rewind and we all leaned in"
  },
  {
   "start": 11.7,
   "end": 15.32,
   "text": " Fourteen seasons later we're still on the screen"
  },
  {
   "start": 16.0,
   "end": 18.66,
   "text": " Final ending, the last conclusion"
  },
  {
   "start": 19.76,
   "end": 23.34,
   "text": " That's the label on the last file"
  },
  {
   "start": 23.34,
   "end": 26.44,
   "text": " Max said we're not done yet"
  },
  {
   "start": 26.44,
   "end": 30.54,
   "text": " But the streamer closed the door in sky"
  },
  {
   "start": 32.36,
   "end": 35.42,
   "text": " Futurama's finished, Futurama's finished"
  },
  {
   "start": 35.42,
   "end": 39.72,
   "text": " For real this time, no more reruns in the dark"
  },
  {
   "start": 39.72,
   "end": 42.72,
   "text": " Futurama's finished, Futurama's finished"
  },
  {
   "start": 42.72,
   "end": 46.88,
   "text": " No fresh episodes, that's the hard part"
  },
  {
   "start": 46.88,
   "end": 50.26,
   "text": " Cut news everyone, the ride is done"
  },
  {
   "start": 50.26,
   "end": 54.2,
   "text": " Cut news everyone, the ship won't run"
  },
  {
   "start": 54.2,
   "end": 57.94,
   "text": " Futurama's finished, Futurama's finished"
  },
  {
   "start": 57.94,
   "end": 63.04,
   "text": " For real this time, no more reruns in the dark"
  }
