  {
   "start": 0.0,
   "end": 7.7,
   "text": " They said it was over back in 03 Then they said it again in 2013"
  },
  {
   "start": 7.7,
   "end": 15.42,
   "text": " Hulu hit rewind and we all leaned in 14 seasons later, we're still on the screen"
  },
  {
   "start": 16.0,
   "end": 23.18,
   "text": " Final ending, the last conclusion That's the label on the last file"
  },
  {
   "start": 23.18,
   "end": 30.86,
   "text": " Matt said we're not done yet, but the streamer closed the door in style"
  },
  {
   "start": 32.36,
   "end": 35.4,
   "text": " Futurama's finished, Futuramah's finished"
  },
  {
   "start": 35.4,
   "end": 39.62,
   "text": " For real this time, no more reruns in the dark"
  },
  {
   "start": 39.62,
   "end": 42.8,
   "text": " Futuramas finished, futuramas finished"
  },
  {
   "start": 42.8,
   "end": 46.74,
   "text": " No fresh episodes, that's the hard part"
  },
  {
   "start": 46.74,
   "end": 50.14,
   "text": " Good news everyone, the ride is done"
  },
  {
   "start": 50.14,
   "end": 54.24,
