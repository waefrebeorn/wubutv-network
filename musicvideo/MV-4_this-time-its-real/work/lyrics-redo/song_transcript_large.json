  },
  {
   "start": 57.92,
   "end": 62.78,
   "text": " For real this time, no more reruns in the dark"
  },
  {
   "start": 64.4,
   "end": 68.56,
   "text": " Three more specials lined up in 27"
  },
  {
   "start": 68.56,
   "end": 71.94,
   "text": " Christmas first, then two more after"
  },
  {
   "start": 71.94,
   "end": 76.36,
   "text": " But a whole new season not on the board"
  },
  {
   "start": 76.36,
   "end": 79.44,
   "text": " They sealed it up and walked out after"
  },
  {
   "start": 79.44,
   "end": 83.26,
   "text": " We've seen this loop from Fox to Cable"
  },
  {
   "start": 83.26,
   "end": 87.06,
   "text": " Then streaming gave it one more round"
  },
  {
   "start": 87.06,
   "end": 90.74,
   "text": " But the song's about the day they mean it"
  },
  {
   "start": 90.74,
   "end": 94.76,
   "text": " When the last new line never comes down"
  },
  {
   "start": 96.06,
   "end": 99.2,
   "text": " Futurama's finished, Futuramma's finished"
  },
  {
