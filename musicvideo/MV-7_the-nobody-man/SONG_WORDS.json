 "segments": [
  {
   "start": 0.0,
   "end": 18.74,
   "text": "I'm the nobody man, nobody man, nobody man, nobody man, nobody man, nobody man, nobody man"
  },
  {
   "start": 19.58,
   "end": 24.62,
   "text": "I got a profile, got a pile, got a thousand posts in a folder file"
  },
  {
   "start": 24.62,
   "end": 29.42,
   "text": "Old meme face in a busted grin been here so long I could sign back in"
  },
  {
   "start": 29.42,
   "end": 34.02,
   "text": "I prayed a joke, got a quarter past eight, watched it sit there while I wait"
  },
  {
   "start": 34.02,
   "end": 38.6,
   "text": "I kept clicking, kept sticking around, little by little I learned the sound"
  },
  {
   "start": 38.6,
   "end": 46.2,
   "text": "Nobody noticing, fine by me, I built my kingdom quietly"
  },
  {
   "start": 47.02,
   "end": 53.82,
   "text": "I'm the nobody man, still here, still stand, I post, I fade, I post again"
  },
  {
   "start": 53.82,
   "end": 58.56,
   "text": "I'm the nobody man, I got a thousand little spots"
  },
  {
   "start": 59.34,
   "end": 67.8,
   "text": "Flipping in the dark, I'm the nobody man, nobody man, nobody man"
  },
  {
   "start": 67.8,
   "end": 75.84,
   "text": "Nobody man, nobody man, nobody man, nobody man"
  },
  {
   "start": 75.84,
   "end": 80.58,
   "text": "I got drafts in the drawer like coins, half-made thoughts in a stack of joints"
  },
  {
   "start": 80.58,
   "end": 85.18,
   "text": "Tiny wins in a lonely room, one more clip and one more zoom"
  },
  {
   "start": 85.18,
   "end": 89.92,
   "text": "Everybody chasing that giant shout, I got a small flame I won't put out"
  },
  {
   "start": 89.92,
   "end": 95.2,
   "text": "I kept clicking, kept sticking around, little by little I learned the sound"
  },
  {
   "start": 95.2,
   "end": 103.36,
   "text": "No one crowned me, no one had to, I made this mess on purpose too"
  },
  {
   "start": 103.36,
   "end": 110.36,
   "text": "I'm the nobody man, still here, still stand, I post, I fade, I post again"
  },
  {
