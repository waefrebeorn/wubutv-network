  {
   "start": 238.0,
   "end": 241.52,
   "text": "You wake up tomorrow and the first thing you hear"
  },
  {
   "start": 241.52,
   "end": 245.14,
   "text": "Is the old man saying it crystal clear"
  },
  {
   "start": 245.14,
   "end": 249.04,
   "text": "I am your dad, I am my dad"
  },
  {
   "start": 249.04,
   "end": 252.82,
   "text": "Say it with me, I'm your dad"
  },
  {
   "start": 252.82,
   "end": 256.48,
   "text": "You hear it once, you hear it twice"
  },
  {
   "start": 256.48,
   "end": 258.58,
   "text": "Now he lives inside"
  },
  {
   "start": 260.26,
   "end": 265.92,
   "text": "I am his dad, every one of you"
  },
  {
   "start": 265.92,
   "end": 267.82,
   "text": "I am your day"
  },
  {
   "start": 267.82,
   "end": 271.9,
   "text": "Don't fight the feeling, just let it in"
  },
  {
   "start": 271.9,
   "end": 273.64,
   "text": "I am you day"
  },
  {
   "start": 275.1,
   "end": 277.78,
   "text": "I am my day"
  },
  {
