 "segments": [
  {
   "start": 58.0,
   "end": 64.28,
   "text": "to stay but the words keep coming and they won't go away i am your dad"
  },
  {
   "start": 70.4,
   "end": 72.64,
   "text": "you'll hear it once you'll"
  },
  {
   "start": 72.64,
   "end": 75.7,
   "text": "hear it twice now it lives inside"
  },
  {
   "start": 81.84,
   "end": 82.06,
   "text": "everyone"
  },
  {
   "start": 88.0,
   "end": 92.96,
   "text": "Let it in, I am your dad, I'm your dad"
  },
  {
   "start": 92.96,
   "end": 97.7,
   "text": "You got your real one maybe, or maybe you don't"
  },
  {
   "start": 97.7,
   "end": 101.4,
   "text": "Don't matter to me, the message is the point"
  },
  {
   "start": 101.4,
   "end": 103.5,
   "text": "I walk through the speakers"
  },
  {
   "start": 103.5,
   "end": 106.7,
   "text": "I sit in the beats, slap bass under brass"
  },
  {
   "start": 106.7,
   "end": 108.96,
   "text": "Hits on the one and the three"
  },
  {
   "start": 108.96,
   "end": 112.9,
   "text": "You try to skip it, you try to change the song"
  },
  {
   "start": 112.9,
   "end": 115.88,
   "text": "But the phrase comes back and it doesn't take long"
  },
  {
   "start": 115.88,
   "end": 118.0,
   "text": "Short words, easy words"
  },
  {
   "start": 118.0,
   "end": 119.92,
   "text": "The kind that stick fast"
  },
  {
   "start": 119.92,
   "end": 121.38,
   "text": "I am your dad"
  }
 ],
