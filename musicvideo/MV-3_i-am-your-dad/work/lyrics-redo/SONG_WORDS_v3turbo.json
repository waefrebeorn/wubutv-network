  },
  {
   "start": 214.56,
   "end": 218.56,
   "text": "They study the hoops, they study the loops"
  },
  {
   "start": 218.56,
   "end": 222.3,
   "text": "They say simple words, make the brain stay tuned"
  },
  {
   "start": 222.3,
   "end": 226.2,
   "text": "Repeat the same line, make it easy to sing"
  },
  {
   "start": 226.2,
   "end": 230.12,
   "text": "And the mind keeps playing it on its own strings"
  },
  {
   "start": 230.12,
   "end": 233.76,
   "text": "I don't need a story, I don' need a name"
  },
  {
   "start": 233.76,
   "end": 237.72,
   "text": "Just the one short claim that never changes"
  },
  {
   "start": 237.72,
   "end": 241.52,
   "text": "You wake up tomorrow and the first thing you hear"
  },
  {
   "start": 241.52,
   "end": 245.14,
   "text": "Is the old man saying it crystal clear"
  },
  {
   "start": 245.14,
   "end": 249.04,
   "text": "I am your dad, I am my dad"
  },
  {
   "start": 249.04,
   "end": 252.82,
