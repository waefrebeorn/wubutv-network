 "segments": [
  {
   "start": 5.06,
   "end": 18.38,
   "text": "Listen, all of you, you already know I am your king."
  },
  {
   "start": 32.1,
   "end": 37.28,
   "text": "I've been here the whole time, kid, looking right at you, old man."
  },
  {
   "start": 37.28,
   "end": 40.12,
   "text": "On the corner, old men in the room."
  },
  {
   "start": 40.16,
   "end": 42.04,
   "text": "You walk by, you scroll by,"
  },
  {
   "start": 42.26,
   "end": 44.1,
   "text": "you turn the radio on"
  },
  {
   "start": 44.1,
   "end": 47.72,
   "text": "and the voice and the speaker says the same thing all along."
  },
  {
   "start": 47.98,
   "end": 51.32,
   "text": "I raised you in the dark, I raised your in the light."
  },
  {
   "start": 51.66,
   "end": 55.1,
   "text": "I raised every face that is listening tonight."
  },
  {
   "start": 55.42,
   "end": 58.5,
   "text": "You don't have to like it, you don't need to stay."
  },
  {
   "start": 58.5,
   "end": 61.94,
   "text": "But the words keep coming and they won't go away"
  },
  {
   "start": 70.4,
   "end": 72.64,
   "text": "you'll hear it once you'll"
  },
  {
   "start": 72.64,
   "end": 75.7,
   "text": "hear it twice now it lives inside"
  },
  {
   "start": 81.84,
   "end": 82.06,
   "text": "everyone"
  },
  {
   "start": 88.0,
   "end": 92.96,
   "text": "Let it in, I am your dad, I'm your dad"
  },
  {
   "start": 92.96,
   "end": 97.7,
   "text": "You got your real one maybe, or maybe you don't"
  },
  {
   "start": 97.7,
   "end": 101.4,
   "text": "Don't matter to me, the message is the point"
  },
  {
   "start": 101.4,
   "end": 103.5,
   "text": "I walk through the speakers"
  },
  {
   "start": 103.5,
   "end": 106.7,
   "text": "I sit in the beats, slap bass under brass"
  },
  {
   "start": 106.7,
   "end": 108.96,
   "text": "Hits on the one and the three"
  },
  {
   "start": 108.96,
   "end": 112.9,
   "text": "You try to skip it, you try to change the song"
  },
  {
   "start": 112.9,
   "end": 115.88,
   "text": "But the phrase comes back and it doesn't take long"
  },
  {
   "start": 115.88,
   "end": 118.0,
   "text": "Short words, easy words"
  },
  {
   "start": 118.0,
   "end": 119.92,
   "text": "The kind that stick fast"
  },
  {
   "start": 119.92,
   "end": 121.38,
   "text": "I am your dad"
  },
  {
   "start": 121.4,
   "end": 123.6,
   "text": "And the song will last"
  },
  {
   "start": 123.6,
   "end": 125.46,
   "text": "I am Your Dad"
  },
  {
   "start": 125.46,
   "end": 127.26,
   "text": "I am My Dad"
  },
  {
   "start": 127.26,
   "end": 129.0,
   "text": "Say it with me"
  },
  {
   "start": 129.0,
   "end": 131.06,
   "text": "I am my Dad"
  },
  {
   "start": 131.06,
   "end": 132.8,
   "text": "You'll hear it once"
  },
  {
   "start": 132.8,
   "end": 134.66,
   "text": "You'll Hear it twice"
  },
  {
   "start": 134.66,
   "end": 136.78,
   "text": "Now it lives inside"
  },
  {
   "start": 136.78,
   "end": 138.66,
   "text": "I am I'm Your Dad"
  },
  {
   "start": 138.66,
   "end": 141.04,
   "text": "I am You Dad"
  },
  {
   "start": 142.38,
   "end": 144.08,
