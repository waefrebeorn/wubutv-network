 "segments": [
  {
   "start": 178.0,
   "end": 182.66,
   "text": "They'll bounce around inside your head"
  },
  {
   "start": 182.66,
   "end": 184.22,
   "text": "I am your dad"
  },
  {
   "start": 184.22,
   "end": 186.48,
   "text": "I am my dad"
  },
  {
   "start": 186.48,
   "end": 190.24,
   "text": "I am his dad"
  },
  {
   "start": 190.24,
   "end": 191.14,
   "text": "I am him"
  },
  {
   "start": 191.14,
   "end": 192.06,
   "text": "I am the dad"
  },
  {
   "start": 192.06,
   "end": 195.6,
   "text": "Old man talking, old man cooing low"
  },
  {
   "start": 195.6,
   "end": 199.38,
   "text": "Telling every listener know what they already know"
  },
  {
   "start": 199.38,
   "end": 201.16,
   "text": "I am yours"
  },
  {
   "start": 214.56,
   "end": 218.56,
   "text": "They study the hoops, they study the loops"
  },
  {
   "start": 218.56,
   "end": 222.3,
   "text": "They say simple words, make the brain stay tuned"
  },
  {
   "start": 222.3,
   "end": 226.2,
   "text": "Repeat the same line, make it easy to sing"
  },
  {
   "start": 226.2,
   "end": 230.12,
   "text": "And the mind keeps playing it on its own strings"
  },
  {
   "start": 230.12,
   "end": 233.76,
   "text": "I don't need a story, I don' need a name"
  },
  {
   "start": 233.76,
   "end": 237.72,
   "text": "Just the one short claim that never changes"
  },
  {
   "start": 237.72,
   "end": 241.52,
   "text": "You wake up tomorrow and the first thing you hear"
  }
 ],
